{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ABA-T1",
  "version": "../package.json",
  "identifier": "io.github.krocon.abat1",
  "build": {
    "frontendDist": "../../../dist/aba-t1/desktop/browser",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ABA-T1",
        "width": 460,
        "height": 920,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "targets": ["deb", "rpm", "appimage", "dmg", "app", "msi", "nsis"],
    "publisher": "Marc Kronberg",
    "copyright": "© 2026 Marc Kronberg",
    "homepage": "https://github.com/krocon/aba-x",
    "category": "Education",
    "shortDescription": "Touch graphing calculator with CAS",
    "longDescription": "ABA-T1 is a graphing calculator with a computer algebra system, apps for functions, statistics, solvers, geometry and a spreadsheet, and a programming language – for macOS, Windows, Linux and the web.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "math"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
