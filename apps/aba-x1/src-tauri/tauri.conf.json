{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ABA-X1",
  "version": "../package.json",
  "identifier": "io.github.krocon.abax",
  "build": {
    "frontendDist": "../../../dist/aba-x1/desktop/browser",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ABA-X1",
        "width": 480,
        "height": 940,
        "minWidth": 380,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app",
      "msi",
      "nsis"
    ],
    "publisher": "Marc Kronberg",
    "copyright": "© 2026 Marc Kronberg",
    "homepage": "https://github.com/krocon/aba-x",
    "category": "Education",
    "shortDescription": "Scientific & symbolic calculator",
    "longDescription": "ABA-X1 is a scientific calculator with a computer algebra system, natural math notation and an interactive function plotter for macOS, Windows, Linux and the web.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "math"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
