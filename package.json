{
  "name": "aba-x",
  "version": "0.1.0",
  "description": "ABA-X1 – Advanced Browser Algebra: scientific & symbolic calculator for desktop (Tauri 2) and web",
  "license": "MIT",
  "author": "Marc Kronberg",
  "repository": {
    "type": "git",
    "url": "https://github.com/krocon/aba-x.git"
  },
  "scripts": {
    "i": "pnpm i",
    "ng": "ng",
    "start": "ng serve",
    "dev": "tauri dev",
    "build": "ng build",
    "build:web": "ng build --configuration web",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,json}\" \"scripts/**/*.mjs\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:mac:local": "tauri build --bundles app,dmg",
    "tauri:build:linux": "tauri build --bundles deb,rpm,appimage",
    "tauri:build:windows": "tauri build --bundles msi,nsis",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "scripts:test": "node --test \"scripts/*.test.mjs\"",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "check": "pnpm version:check && pnpm scripts:test && pnpm format:check && pnpm lint && pnpm test && pnpm build && pnpm build:web && pnpm rust:fmt && pnpm rust:lint && pnpm rust:test && pnpm notices:check"
  },
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "mathlive": "0.111.4",
    "nerdamer": "2.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "angular-eslint": "22.6.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.0.0",
    "playwright": "1.56.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
