{
  "name": "aba",
  "description": "ABA calculators – monorepo of ABA-X1 (scientific & symbolic calculator) and further calculators for desktop (Tauri 2) and web",
  "license": "MIT",
  "author": "Marc Kronberg",
  "repository": {
    "type": "git",
    "url": "https://github.com/krocon/aba-x.git"
  },
  "scripts": {
    "i": "pnpm i",
    "ng": "ng",
    "start": "ng serve aba-x1",
    "dev": "pnpm tauri dev",
    "build": "ng build aba-x1",
    "build:web": "ng build aba-x1 --configuration web",
    "watch": "ng build aba-x1 --watch --configuration development",
    "test": "pnpm test:math && pnpm test:ppl && ng test aba-x1 --watch=false && ng test aba-t1 --watch=false",
    "test:math": "pnpm --filter @aba/math test",
    "test:ppl": "pnpm --filter @aba/ppl test",
    "test:watch": "ng test aba-x1",
    "lint": "eslint apps packages",
    "format": "prettier --write \"apps/*/src/**/*.{ts,html,css,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,html,css,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.mjs\"",
    "tauri": "pnpm --filter aba-x1 exec tauri",
    "tauri:dev": "pnpm tauri dev",
    "tauri:build:mac": "pnpm tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:mac:local": "pnpm tauri build --bundles app,dmg",
    "tauri:build:linux": "pnpm tauri build --bundles deb,rpm,appimage",
    "tauri:build:windows": "pnpm tauri build --bundles msi,nsis",
    "rust:fmt": "node scripts/rust.mjs fmt",
    "rust:lint": "node scripts/rust.mjs lint",
    "rust:test": "node scripts/rust.mjs test",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "scripts:test": "node --test \"scripts/*.test.mjs\"",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "check": "pnpm version:check && pnpm scripts:test && pnpm format:check && pnpm lint && pnpm test && pnpm build:all && pnpm rust:fmt && pnpm rust:lint && pnpm rust:test && pnpm notices:check",
    "e2e": "node scripts/e2e/run.mjs --build",
    "release:notes": "node scripts/release-notes.mjs",
    "screenshots": "pnpm build:web && node scripts/screenshots/run.mjs",
    "serve:web": "node scripts/e2e/run.mjs --serve 4300",
    "screenshots:examples": "pnpm build:web && node scripts/screenshots/run.mjs examples",
    "screenshots:site": "pnpm build:web && node scripts/screenshots/run.mjs site",
    "build:all": "ng build aba-x1 && ng build aba-x1 --configuration web && ng build aba-t1 && ng build aba-t1 --configuration web"
  },
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@micropython/micropython-webassembly-pyscript": "1.29.0-6",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "mathlive": "0.111.4",
    "nerdamer": "2.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "angular-eslint": "22.6.0",
    "axe-core": "4.11.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.0.0",
    "playwright": "1.56.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
